# Copia este archivo a .env y completa los valores para conectar base de datos y auth real.
# Mientras tanto, el frontend funciona con datos demo (src/lib/demo-data.ts) sin backend.

# PostgreSQL (usado por prisma/schema.prisma en la siguiente fase)
DATABASE_URL="postgresql://usuario:password@localhost:5432/bistro_mecha"

# Firma de sesiones (ver src/lib/auth.ts)
JWT_SECRET="cambia-esto-por-un-valor-largo-y-aleatorio"

# Dominio público usado para construir los QR de mesa (src/app/admin/configuracion)
NEXT_PUBLIC_APP_URL="https://bistromecha.app"
